---
import { Image } from 'astro:assets';
import logoImg from '../assets/images/logo.png';
import { footerMenus } from '../menus';
import socialData from '../content/social.json';
---

<footer class="relative overflow-hidden bg-gray-950 text-gray-300 border-t border-emerald-500/15 pt-16 pb-8 md:pt-20 md:pb-10 transition-colors">
    <!-- Ambient Glow Efek Elegan yang Selaras dengan Tema -->
    <div
        class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 h-56 w-full max-w-4xl bg-gradient-to-r from-emerald-500/10 via-green-500/10 to-transparent blur-3xl opacity-70">
    </div>
    <div
        class="pointer-events-none absolute -bottom-10 right-0 h-64 w-64 rounded-full bg-emerald-600/5 blur-3xl">
    </div>

    <div class="relative z-10 container mx-auto px-6 md:px-12">
        <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-10">
            <!-- Kolom 1: Profil Brand & Medsos (4 Kolom di Desktop) -->
            <div class="space-y-5 lg:col-span-4">
                <a href="/" class="group inline-flex items-center gap-3">
                    <Image
                        class="h-10 sm:h-11 w-auto transition-transform duration-300 group-hover:scale-105"
                        src={logoImg}
                        alt="Logo Computer Education"
                    />
                    <div>
                        <span class="block text-base font-bold text-white tracking-tight group-hover:text-emerald-400 transition-colors">
                            Computer Education
                        </span>
                        <span class="block text-xs font-medium text-emerald-400">
                            UM Cirebon
                        </span>
                    </div>
                </a>
                <p class="text-sm leading-relaxed text-gray-400 max-w-sm">
                    Wadah mahasiswa untuk berkreasi, berinovasi, dan berkontribusi membangun kampus yang lebih baik melalui pemanfaatan teknologi dan kolaborasi digital.
                </p>
                <div class="flex items-center gap-3 pt-1">
                    <a
                        href={socialData.instagram || "#"}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram Computer Education"
                        class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-xl border border-gray-800 bg-gray-900/90 text-gray-400 transition-all duration-300 hover:-translate-y-0.5 hover:border-emerald-500 hover:bg-emerald-600 hover:text-white shadow-sm">
                        <i class="fa-brands fa-instagram text-base"></i>
                    </a>
                    <a
                        href={socialData.youtube || "#"}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="YouTube Computer Education"
                        class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-xl border border-gray-800 bg-gray-900/90 text-gray-400 transition-all duration-300 hover:-translate-y-0.5 hover:border-emerald-500 hover:bg-emerald-600 hover:text-white shadow-sm">
                        <i class="fa-brands fa-youtube text-base"></i>
                    </a>
                    <a
                        href={socialData.tiktok || "#"}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="TikTok Computer Education"
                        class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-xl border border-gray-800 bg-gray-900/90 text-gray-400 transition-all duration-300 hover:-translate-y-0.5 hover:border-emerald-500 hover:bg-emerald-600 hover:text-white shadow-sm">
                        <i class="fa-brands fa-tiktok text-base"></i>
                    </a>
                    <a
                        href={`https://wa.me/${socialData.whatsapp || '6281291300572'}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="WhatsApp Computer Education"
                        class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-xl border border-gray-800 bg-gray-900/90 text-gray-400 transition-all duration-300 hover:-translate-y-0.5 hover:border-emerald-500 hover:bg-emerald-600 hover:text-white shadow-sm">
                        <i class="fa-brands fa-whatsapp text-base"></i>
                    </a>
                </div>
            </div>

            <!-- Kolom 2: Menu Jelajahi (2 Kolom di Desktop) -->
            <div class="lg:col-span-2 sm:col-span-1">
                <h3 class="mb-5 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-emerald-400">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                    Jelajahi
                </h3>
                <ul class="space-y-3">
                    {footerMenus.map((menu) => (
                        <li>
                            <a
                                href={menu.href}
                                class="group inline-flex items-center gap-2 text-sm text-gray-400 transition-all duration-200 hover:text-white">
                                <span class="h-1 w-1 rounded-full bg-emerald-500/0 transition-all duration-200 group-hover:w-2 group-hover:bg-emerald-400"></span>
                                <span class="group-hover:translate-x-0.5 transition-transform duration-200">{menu.name}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Kolom 3: Kontak Kami (3 Kolom di Desktop) -->
            <div class="lg:col-span-3 sm:col-span-1">
                <h3 class="mb-5 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-emerald-400">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                    Hubungi Kami
                </h3>
                <ul class="space-y-4 text-sm text-gray-400">
                    <li class="flex items-start gap-3">
                        <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-emerald-500/20 bg-emerald-500/10 text-emerald-400">
                            <i class="fa-solid fa-location-dot text-xs"></i>
                        </span>
                        <span class="leading-relaxed">
                            Jl. Fatahillah No. 10, Kabupaten Cirebon (Universitas Muhammadiyah Cirebon)
                        </span>
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-emerald-500/20 bg-emerald-500/10 text-emerald-400">
                            <i class="fa-solid fa-envelope text-xs"></i>
                        </span>
                        <a
                            href="mailto:computer_education@umc.ac.id"
                            class="truncate transition-colors hover:text-emerald-400">
                            computer_education@umc.ac.id
                        </a>
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-emerald-500/20 bg-emerald-500/10 text-emerald-400">
                            <i class="fa-brands fa-whatsapp text-sm"></i>
                        </span>
                        <a
                            href={`https://wa.me/${socialData.whatsapp || '6281291300572'}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="transition-colors hover:text-emerald-400">
                            +62 812-9130-0572
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Kolom 4: Tanya Admin / WhatsApp Langsung (3 Kolom di Desktop) -->
            <div class="lg:col-span-3 sm:col-span-2">
                <h3 class="mb-5 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-emerald-400">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                    Tanya Admin
                </h3>
                <p class="mb-4 text-sm leading-relaxed text-gray-400">
                    Punya pertanyaan seputar organisasi atau materi? Kirim pesan langsung melalui WhatsApp.
                </p>
                <form id="wa-form" class="space-y-3">
                    <div class="relative">
                        <input
                            id="pesan"
                            type="text"
                            required
                            placeholder="Tulis pesan pertanyaan..."
                            class="w-full rounded-xl border border-gray-800 bg-gray-900/90 px-4 py-2.5 text-sm text-white placeholder-gray-500 transition-all focus:border-emerald-500 focus:bg-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20" />
                    </div>
                    <button
                        type="submit"
                        class="group flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-green-600 to-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-lg shadow-emerald-950/50 transition-all duration-300 hover:from-green-500 hover:to-emerald-500 hover:shadow-emerald-500/20 active:scale-[0.98] cursor-pointer">
                        <span>Kirim WhatsApp</span>
                        <i class="fa-brands fa-whatsapp text-base transition-transform group-hover:scale-110"></i>
                    </button>
                </form>
            </div>
        </div>

        <!-- Garis Pemisah & Bagian Hak Cipta -->
        <div class="mt-12 sm:mt-16 border-t border-gray-800/80 pt-6 sm:pt-8">
            <div class="flex flex-col items-center justify-between gap-4 text-center text-xs sm:text-sm text-gray-500 sm:flex-row sm:text-left">
                <p>
                    &copy; {new Date().getFullYear()} <span class="font-medium text-gray-300">Computer Education UMC</span>. All rights reserved.
                </p>
                <div class="flex items-center gap-6">
                    <a href="#" class="transition-colors hover:text-emerald-400"> Kebijakan Privasi </a>
                    <span class="h-3 w-px bg-gray-800"></span>
                    <a href="#" class="transition-colors hover:text-emerald-400"> Syarat & Ketentuan </a>
                </div>
            </div>
        </div>
    </div>
</footer>

<script define:vars={{ waNumber: socialData.whatsapp }}>
    const waForm = document.getElementById('wa-form');
    if (waForm) {
        waForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const pesanInput = document.getElementById('pesan');
            if (pesanInput && pesanInput.value.trim()) {
                const pesan = pesanInput.value.trim();
                const nomorWA = waNumber || '6281291300572';
                const waText = `Halo Admin Computer Education, saya ingin bertanya: ${pesan}`;
                const url = `https://wa.me/${nomorWA}?text=${encodeURIComponent(waText)}`;
                window.open(url, '_blank');
            }
        });
    }
</script>
