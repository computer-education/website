---
import { Image } from 'astro:assets'
import logoImg from '../assets/images/logo.png'
import { mainMenus } from '../menus.ts'

// Logika untuk menentukan apakah ini di halaman Home atau bukan
const pathname = new URL(Astro.request.url).pathname
---

<header
    id="main-header"
    class="fixed top-3 sm:top-5 left-1/2 -translate-x-1/2 z-50 w-[94%] max-w-6xl transition-all duration-300">
    <div class="rounded-full bg-white/95 dark:bg-gray-900/95 border border-gray-200/90 dark:border-gray-800/90 shadow-xl shadow-black/8 backdrop-blur-md px-4 py-2 sm:px-6 sm:py-2.5 flex items-center justify-between gap-4">
        
        <!-- Logo Brand -->
        <a href="/" class="group flex items-center shrink-0" aria-label="Beranda Computer Education">
            <Image
                class="h-8 sm:h-9 w-auto transition-transform duration-300 group-hover:scale-105"
                src={logoImg}
                alt="Logo Computer Education"
            />
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden lg:flex items-center gap-6 xl:gap-8">
            {mainMenus.map((menu) => {
                const hasChildren = menu.children && menu.children.length > 0;
                const isActive = menu.href === '/' ? pathname === '/' : (menu.href !== '#' && pathname.startsWith(menu.href));

                if (hasChildren) {
                    const isAnyChildActive = menu.children?.some((child: any) => pathname.startsWith(child.href));
                    return (
                        <div class="group relative py-1" tabindex="0">
                            <button
                                type="button"
                                class={`nav-link text-xs xl:text-sm font-semibold flex items-center gap-1 transition-colors cursor-pointer ${
                                    isAnyChildActive
                                        ? "text-gray-950 dark:text-white font-bold"
                                        : "text-gray-700 dark:text-gray-200 hover:text-emerald-600 dark:hover:text-emerald-400"
                                }`}>
                                <span>{menu.name}</span>
                                <svg
                                    class="h-3 w-3 transition-transform duration-200 group-hover:rotate-180 text-gray-400 group-hover:text-emerald-600 dark:text-gray-500"
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke-width="2.5"
                                    stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                                </svg>
                            </button>
                            
                            <!-- Dropdown Box -->
                            <div class="left-1/2 -translate-x-1/2 top-full mt-3 invisible opacity-0 -translate-y-2 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 absolute min-w-[180px] flex-col gap-1 rounded-2xl border border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 p-2 shadow-2xl backdrop-blur-xl transition-all duration-200 z-50">
                                {menu.children?.map((child: any) => {
                                    const isChildActive = pathname.startsWith(child.href);
                                    return (
                                        <a 
                                            href={child.href} 
                                            class={`block rounded-xl px-3.5 py-2 text-xs font-semibold transition-all hover:bg-emerald-50 dark:hover:bg-gray-800/80 hover:text-emerald-700 dark:hover:text-emerald-400 ${
                                                isChildActive 
                                                    ? 'bg-emerald-50 dark:bg-gray-800/90 text-emerald-700 dark:text-emerald-400' 
                                                    : 'text-gray-600 dark:text-gray-300'
                                            }`}>
                                            {child.name}
                                        </a>
                                    )
                                })}
                            </div>
                        </div>
                    )
                }

                return (
                    <a 
                        class={`nav-link relative text-xs xl:text-sm font-semibold transition-colors py-1 ${
                            isActive 
                                ? "text-gray-950 dark:text-white font-bold after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-0.5 after:bg-gray-950 dark:after:bg-white after:rounded-full" 
                                : "text-gray-700 dark:text-gray-200 hover:text-emerald-600 dark:hover:text-emerald-400"
                        }`} 
                        href={menu.href}>
                        {menu.name}
                    </a>
                )
            })}
        </nav>

        <!-- Right Controls (Theme Toggle & LMS Button) -->
        <div class="flex items-center gap-2 sm:gap-3">
            <!-- Theme Toggle -->
            <button 
                class="theme-toggle flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-full bg-gray-100/90 text-gray-600 transition-colors hover:bg-gray-200 hover:text-emerald-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700 dark:hover:text-emerald-400 cursor-pointer" 
                aria-label="Ganti Tema">
                <i class="ph-fill ph-moon block text-base dark:hidden"></i>
                <i class="ph-fill ph-sun hidden text-base dark:block"></i>
            </button>

            <!-- Login LMS Button (Neon Lime from Figma) -->
            <a
                href="https://forms.gle/4b4VrtB3DuYyUnGRA"
                target="_blank"
                rel="noopener noreferrer"
                class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-[#a3e635] hover:bg-[#bef264] active:scale-95 text-gray-950 px-4 sm:px-5 py-2 text-xs sm:text-sm font-bold shadow-xs transition-all duration-200 whitespace-nowrap">
                <span>Login LMS</span>
                <i class="ph-bold ph-arrow-right text-xs"></i>
            </a>

            <!-- Mobile Menu Toggle Button -->
            <button
                id="mobile-menu-toggle"
                type="button"
                class="flex lg:hidden h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-full bg-gray-100/90 text-gray-700 hover:bg-emerald-50 hover:text-emerald-600 active:scale-95 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700 cursor-pointer"
                aria-label="Buka Menu"
                aria-expanded="false">
                <i id="menu-icon-open" class="ph ph-list text-xl"></i>
                <i id="menu-icon-close" class="ph ph-x hidden text-xl"></i>
            </button>
        </div>
    </div>

    <!-- Mobile Menu Backdrop -->
    <div
        id="mobile-backdrop"
        class="fixed inset-0 z-40 bg-black/40 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden">
    </div>

    <!-- Mobile Menu Panel -->
    <div
        id="mobile-menu-panel"
        class="pointer-events-none absolute top-full left-0 right-0 z-50 origin-top -translate-y-2 pt-2 pb-5 opacity-0 transition-all duration-300 ease-out lg:hidden">
        <div class="max-h-[calc(100vh-100px)] overflow-y-auto rounded-3xl border border-gray-100/90 bg-white/95 p-4 shadow-2xl backdrop-blur-2xl dark:border-gray-800 dark:bg-gray-900/95 space-y-1">
            {mainMenus.map((menu) => {
                const hasChildren = menu.children && menu.children.length > 0;
                const isActive = menu.href === '/' ? pathname === '/' : (menu.href !== '#' && pathname.startsWith(menu.href));

                if (hasChildren) {
                    const isAnyChildActive = menu.children?.some((child: any) => pathname.startsWith(child.href));
                    return (
                        <div class="mobile-accordion">
                            <button
                                type="button"
                                class={`mobile-accordion-toggle flex w-full items-center justify-between rounded-xl px-3.5 py-2.5 text-sm font-semibold transition-all ${
                                    isAnyChildActive
                                        ? 'bg-emerald-50 text-emerald-700 dark:bg-gray-800 dark:text-emerald-400'
                                        : 'text-gray-700 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800/60'
                                }`}>
                                <span>{menu.name}</span>
                                <svg
                                    class={`chevron-icon h-4 w-4 transition-transform duration-200 ${isAnyChildActive ? 'rotate-180 text-emerald-600' : 'text-gray-400'}`}
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke-width="2.5"
                                    stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                                </svg>
                            </button>
                            <div class={`mobile-submenu flex-col pl-4 pr-1 py-1 space-y-1 border-l-2 border-emerald-500/25 ml-4 my-1 ${isAnyChildActive ? 'flex' : 'hidden'}`}>
                                {menu.children?.map((child: any) => {
                                    const isChildActive = pathname.startsWith(child.href);
                                    return (
                                        <a
                                            href={child.href}
                                            class={`mobile-link flex items-center justify-between rounded-lg px-3 py-2 text-xs font-semibold transition-all ${
                                                isChildActive
                                                    ? 'bg-emerald-50 text-emerald-700 dark:bg-gray-800 dark:text-emerald-400'
                                                    : 'text-gray-600 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800/50'
                                            }`}>
                                            <span>{child.name}</span>
                                            {isChildActive && <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>}
                                        </a>
                                    )
                                })}
                            </div>
                        </div>
                    );
                }

                return (
                    <a
                        href={menu.href}
                        class={`mobile-link flex items-center justify-between rounded-xl px-3.5 py-2.5 text-sm font-semibold transition-all ${
                            isActive
                                ? 'bg-emerald-50 text-emerald-700 dark:bg-gray-800 dark:text-emerald-400 font-bold'
                                : 'text-gray-700 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800/60'
                        }`}>
                        <span>{menu.name}</span>
                        {isActive && <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>}
                    </a>
                );
            })}

            <!-- Mobile Login LMS Button -->
            <div class="pt-2">
                <a
                    href="https://forms.gle/4b4VrtB3DuYyUnGRA"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#a3e635] hover:bg-[#bef264] py-2.5 text-center text-sm font-bold text-gray-950 shadow-sm active:scale-98 transition-all">
                    <span>Login LMS</span>
                    <i class="ph-bold ph-arrow-right text-xs"></i>
                </a>
            </div>
        </div>
    </div>
</header>

<script>
    // Theme Toggle Logic
    const toggleTheme = () => {
        const isDark = document.documentElement.classList.contains('dark')
        if (isDark) {
            document.documentElement.classList.remove('dark')
            localStorage.setItem('theme', 'light')
        } else {
            document.documentElement.classList.add('dark')
            localStorage.setItem('theme', 'dark')
        }
    }

    const themeButtons = document.querySelectorAll('.theme-toggle')
    themeButtons.forEach(btn => btn.addEventListener('click', toggleTheme))

    // Mobile Menu Controls
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle')
    const mobileMenuPanel = document.getElementById('mobile-menu-panel')
    const mobileBackdrop = document.getElementById('mobile-backdrop')
    const iconOpen = document.getElementById('menu-icon-open')
    const iconClose = document.getElementById('menu-icon-close')

    const openMobileMenu = () => {
        if (!mobileMenuPanel || !mobileBackdrop || !iconOpen || !iconClose || !mobileMenuToggle) return
        mobileMenuPanel.classList.remove('pointer-events-none', 'opacity-0', '-translate-y-2')
        mobileMenuPanel.classList.add('pointer-events-auto', 'opacity-100', 'translate-y-0')
        mobileBackdrop.classList.remove('pointer-events-none', 'opacity-0')
        mobileBackdrop.classList.add('pointer-events-auto', 'opacity-100')
        iconOpen.classList.add('hidden')
        iconClose.classList.remove('hidden')
        mobileMenuToggle.setAttribute('aria-expanded', 'true')
    }

    const closeMobileMenu = () => {
        if (!mobileMenuPanel || !mobileBackdrop || !iconOpen || !iconClose || !mobileMenuToggle) return
        mobileMenuPanel.classList.add('pointer-events-none', 'opacity-0', '-translate-y-2')
        mobileMenuPanel.classList.remove('pointer-events-auto', 'opacity-100', 'translate-y-0')
        mobileBackdrop.classList.add('pointer-events-none', 'opacity-0')
        mobileBackdrop.classList.remove('pointer-events-auto', 'opacity-100')
        iconOpen.classList.remove('hidden')
        iconClose.classList.add('hidden')
        mobileMenuToggle.setAttribute('aria-expanded', 'false')
    }

    if (mobileMenuToggle) {
        mobileMenuToggle.addEventListener('click', () => {
            const isExpanded = mobileMenuToggle.getAttribute('aria-expanded') === 'true'
            if (isExpanded) {
                closeMobileMenu()
            } else {
                openMobileMenu()
            }
        })
    }

    if (mobileBackdrop) {
        mobileBackdrop.addEventListener('click', closeMobileMenu)
    }

    // Accordion di Menu Mobile
    const accordions = document.querySelectorAll('.mobile-accordion')
    accordions.forEach(acc => {
        const toggle = acc.querySelector('.mobile-accordion-toggle')
        const submenu = acc.querySelector('.mobile-submenu')
        const chevron = acc.querySelector('.chevron-icon')

        if (toggle && submenu && chevron) {
            toggle.addEventListener('click', () => {
                const isHidden = submenu.classList.contains('hidden')
                if (isHidden) {
                    submenu.classList.remove('hidden')
                    submenu.classList.add('flex')
                    chevron.classList.add('rotate-180')
                } else {
                    submenu.classList.remove('flex')
                    submenu.classList.add('hidden')
                    chevron.classList.remove('rotate-180')
                }
            })
        }
    })

    // Tutup saat link diklik
    const mobileLinks = document.querySelectorAll('.mobile-link')
    mobileLinks.forEach(link => {
        link.addEventListener('click', closeMobileMenu)
    })
</script>
