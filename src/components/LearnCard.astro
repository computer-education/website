---
import { Image } from 'astro:assets';

interface Props {
    module: any;
    class?: string;
}

const { module, class: className = '' } = Astro.props;

// Menyelesaikan path gambar secara dinamis dari src/assets/images
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{jpeg,jpg,png,gif}');
const imagePath = `/src/assets/images/${module.data.image}`;

// Cek apakah gambar ada
const imageSrc = images[imagePath] ? images[imagePath]() : null;

// Metadata pelengkap tiap divisi/track agar tampilan lebih hidup & profesional
const trackInfo: Record<string, { icon: string; category: string; gradient: string }> = {
    'programing': {
        icon: 'ph ph-code',
        category: 'Software & Logic',
        gradient: 'from-blue-600 via-indigo-600 to-cyan-500'
    },
    'desain-grafis': {
        icon: 'ph ph-paint-brush-broad',
        category: 'Visual & Branding',
        gradient: 'from-fuchsia-600 via-pink-600 to-rose-500'
    },
    'fotografi': {
        icon: 'ph ph-camera',
        category: 'Multimedia & Lens',
        gradient: 'from-amber-500 via-orange-600 to-red-500'
    },
    'video-editing': {
        icon: 'ph ph-film-strip',
        category: 'Cinema & Motion',
        gradient: 'from-rose-600 via-red-600 to-amber-500'
    },
    'sistem-operasi': {
        icon: 'ph ph-terminal-window',
        category: 'System & Infra',
        gradient: 'from-emerald-700 via-teal-800 to-gray-950'
    }
};

const currentTrack = trackInfo[module.id] || {
    icon: 'ph ph-book-open-text',
    category: 'Kurikulum IT',
    gradient: 'from-green-600 via-emerald-600 to-teal-500'
};
---

<div class={`group h-full ${className}`}>
    <div
        class="h-full cursor-pointer flex flex-col rounded-3xl border border-gray-100 dark:border-gray-800/80 bg-white dark:bg-gray-900 overflow-hidden shadow-sm hover:shadow-2xl hover:shadow-green-500/10 dark:hover:shadow-green-900/20 transition-all duration-500 hover:-translate-y-2 select-none"
        onclick={`window.location.href = '/learning/${module.id}'`}>
        
        <!-- Header Banner & Image -->
        <div class="relative h-48 sm:h-56 w-full overflow-hidden shrink-0 bg-gray-100 dark:bg-gray-800">
            {imageSrc ? (
                <>
                    <Image
                        src={imageSrc}
                        alt={module.data.title}
                        class="h-full w-full object-cover transform transition-transform duration-700 ease-out group-hover:scale-108"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-60 transition-opacity duration-300 group-hover:opacity-40"></div>
                </>
            ) : (
                <div class={`h-full w-full bg-gradient-to-br ${currentTrack.gradient} flex flex-col items-center justify-center p-6 text-white relative overflow-hidden`}>
                    <div class="absolute -right-6 -bottom-6 opacity-20 transform rotate-12">
                        <i class={`${currentTrack.icon} text-9xl`}></i>
                    </div>
                    <div class="relative z-10 flex flex-col items-center text-center">
                        <div class="w-16 h-16 rounded-2xl bg-white/15 backdrop-blur-md border border-white/20 flex items-center justify-center mb-3 shadow-lg">
                            <i class={`${currentTrack.icon} text-3xl text-white`}></i>
                        </div>
                        <span class="text-xs font-bold tracking-widest uppercase text-white/80">{currentTrack.category}</span>
                        <span class="text-lg font-extrabold text-white mt-1">{module.data.title}</span>
                    </div>
                </div>
            )}
            
            <!-- Badges di atas gambar -->
            <div class="absolute top-4 left-4 right-4 flex items-center justify-between gap-2 z-20">
                {module.data.badge && module.data.badge.trim() !== '' ? (
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-green-500/95 backdrop-blur-md px-3.5 py-1 text-xs font-bold text-white shadow-lg shadow-green-500/30 border border-green-400/40">
                        <i class="ph-fill ph-sparkle text-[11px]"></i>
                        {module.data.badge}
                    </span>
                ) : (
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-black/50 backdrop-blur-md px-3.5 py-1 text-xs font-semibold text-white/90 border border-white/15">
                        <i class={`${currentTrack.icon} text-xs text-green-400`}></i>
                        {currentTrack.category}
                    </span>
                )}
            </div>
        </div>

        <!-- Body Card -->
        <div class="p-5 sm:p-6 md:p-7 flex flex-col grow justify-between bg-white dark:bg-gray-900">
            <div>
                <div class="flex items-center gap-2 mb-2.5 sm:mb-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-green-600 dark:text-green-500">
                        {currentTrack.category}
                    </span>
                    <span class="text-gray-300 dark:text-gray-700">•</span>
                    <span class="text-xs font-medium text-gray-400 dark:text-gray-500">
                        Modul Kurikulum
                    </span>
                </div>

                <h3 class="mb-2.5 sm:mb-3 text-xl sm:text-2xl font-bold text-gray-900 dark:text-white transition-colors duration-300 group-hover:text-green-600 dark:group-hover:text-green-400 leading-snug">
                    {module.data.title}
                </h3>

                {module.data.description && (
                    <p class="mb-4 sm:mb-6 line-clamp-3 text-xs sm:text-sm leading-relaxed text-gray-500 dark:text-gray-400">
                        {module.data.description}
                    </p>
                )}
            </div>

            <!-- Footer Card (CTA) -->
            <div class="pt-4 sm:pt-5 border-t border-gray-100 dark:border-gray-800/80 flex items-center justify-between mt-auto">
                <span class="text-xs sm:text-sm font-bold text-gray-700 dark:text-gray-300 group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors">
                    {module.data.cta_text || 'Mulai Belajar'}
                </span>
                <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-gray-50 dark:bg-gray-800 flex items-center justify-center text-gray-600 dark:text-gray-300 group-hover:bg-green-600 group-hover:text-white group-hover:scale-110 transition-all duration-300 shadow-sm">
                    <i class="ph ph-arrow-right text-base sm:text-lg transition-transform duration-300 group-hover:translate-x-0.5"></i>
                </div>
            </div>
        </div>
    </div>
</div>
