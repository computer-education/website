---
import { Image } from 'astro:assets';
import harlahImg from '../../assets/images/harlah 23.jpg';
---

<!-- Tentang CE -->
<section id="about" class="border-y border-gray-200 dark:border-gray-800 bg-gray-50/60 dark:bg-gray-900/40 px-6 py-20 transition-colors">
    <div class="container mx-auto grid items-center gap-12 lg:grid-cols-12 max-w-6xl">
        <!-- Foto Dokumentasi -->
        <div class="lg:col-span-5">
            <div class="overflow-hidden rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-sm">
                <Image 
                    src={harlahImg} 
                    alt="Peringatan Hari Lahir UKM Computer Education UMC" 
                    class="h-auto w-full object-cover" 
                />
                <div class="p-3 text-center border-t border-gray-100 dark:border-gray-800/80 bg-white dark:bg-gray-900 text-xs text-gray-500 dark:text-gray-400">
                    Dokumentasi Harlah ke-23 UKM Computer Education UMC
                </div>
            </div>
        </div>

        <!-- Uraian Ringkas -->
        <div class="lg:col-span-7 space-y-6">
            <div class="space-y-3">
                <div class="flex items-center gap-2 text-xs font-semibold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider">
                    <span>Tentang Organisasi</span>
                    <span>•</span>
                    <span class="text-gray-500 dark:text-gray-400">Didirikan 2001</span>
                </div>
                <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-950 dark:text-white leading-tight">
                    Membina Keilmuan Teknologi & Kaderisasi Mahasiswa
                </h2>
            </div>

            <p class="text-base text-gray-600 dark:text-gray-300 leading-relaxed font-normal">
                Unit Kegiatan Mahasiswa <strong>Computer Education (CE)</strong> resmi berdiri pada <strong>21 April 2001</strong> di Universitas Muhammadiyah Cirebon. Berawal dari inisiatif para perintis untuk memfasilitasi mahasiswa belajar komputer di tengah keterbatasan fasilitas kampus saat itu, CE kini menjadi rumah pembinaan di bidang rekayasa perangkat lunak, desain grafis, multimedia kreatif, dan infrastruktur jaringan.
            </p>

            <!-- Faktual 3-Grid -->
            <div class="grid grid-cols-3 gap-4 pt-2 pb-2 border-y border-gray-200 dark:border-gray-800">
                <div>
                    <span class="block text-2xl font-bold text-gray-950 dark:text-white">2001</span>
                    <span class="text-xs text-gray-500 dark:text-gray-400">Tahun Berdiri</span>
                </div>
                <div>
                    <span class="block text-2xl font-bold text-gray-950 dark:text-white">20+</span>
                    <span class="text-xs text-gray-500 dark:text-gray-400">Periode Ketua</span>
                </div>
                <div>
                    <span class="block text-2xl font-bold text-gray-950 dark:text-white">4</span>
                    <span class="text-xs text-gray-500 dark:text-gray-400">Peminatan Inti</span>
                </div>
            </div>

            <!-- Tautan Navigasi -->
            <div class="flex flex-wrap items-center gap-4 pt-1">
                <a
                    href="/about"
                    class="inline-flex items-center gap-2 rounded-lg bg-emerald-700 hover:bg-emerald-800 dark:bg-emerald-600 dark:hover:bg-emerald-500 px-5 py-2.5 text-sm font-semibold text-white shadow-xs transition-colors">
                    <span>Baca Profil Lengkap</span>
                    <i class="ph-bold ph-arrow-right text-sm"></i>
                </a>

                <a
                    href="/buku-saku"
                    class="inline-flex items-center gap-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 hover:bg-gray-50 dark:hover:bg-gray-800 px-4 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-200 transition-colors">
                    <span>Buku Saku Organisasi</span>
                </a>
            </div>
        </div>
    </div>
</section>
