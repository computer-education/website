---
// Bidang & Divisi UKM CE Section sesuai Desain Figma
---

<!-- Section Bidang & Divisi UKM Computer Education -->
<section class="relative bg-[#edf9f1] dark:bg-gray-950 py-16 sm:py-24 lg:py-28 px-5 sm:px-8 lg:px-12 transition-colors overflow-hidden" id="divisi">
    
    <!-- Ambient Background Glow -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="absolute -top-40 -left-40 w-[600px] h-[600px] bg-emerald-400/10 blur-[130px] rounded-full"></div>
        <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-emerald-500/10 blur-[120px] rounded-full"></div>
    </div>

    <!-- Main Container -->
    <div class="relative z-10 container mx-auto max-w-7xl">
        
        <!-- Header Grid: Title on Left, Narrative & Meta on Right -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end mb-12 sm:mb-16">
            
            <!-- Left Side: Badge & Main Title -->
            <div class="lg:col-span-7 space-y-3">
                <!-- Eyebrow Pill Badge -->
                <div class="inline-flex items-center gap-2 rounded-full border border-emerald-900/15 bg-white/80 dark:bg-gray-900/80 px-3 py-1 text-[11px] sm:text-xs font-bold text-emerald-800 dark:text-emerald-400 shadow-2xs backdrop-blur-xs select-none">
                    <span class="h-2 w-2 rounded-full bg-emerald-600 animate-pulse"></span>
                    <span>BIDANG & DIVISI</span>
                    <span class="text-gray-300 dark:text-gray-700">|</span>
                    <span class="text-gray-500 dark:text-gray-400 font-medium">UKM CE • UMC</span>
                </div>

                <!-- Main Headline -->
                <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-extrabold text-gray-950 dark:text-white leading-[1.14] tracking-tight">
                    Satu Organisasi,<br />
                    Beragam Ruang untuk<br />
                    <span class="relative inline-block">
                        Berkarya.
                        <!-- Hand-drawn Lime Accent Line -->
                        <svg class="absolute -bottom-2 left-0 w-full h-3 text-[#a3e635]" viewBox="0 0 200 12" fill="none" preserveAspectRatio="none">
                            <path d="M2 9C50 3 150 3 198 9" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                        </svg>
                    </span>
                </h2>

                <!-- Technical Code Tag -->
                <div class="flex items-center gap-2 pt-2 select-none">
                    <span class="font-mono text-[11px] font-bold tracking-wider text-emerald-700/80 dark:text-emerald-400 uppercase">
                        UKM-CE-STRUCT // 2024-2025
                    </span>
                    <span class="h-2 w-2 rounded-full bg-[#a3e635]"></span>
                </div>
            </div>

            <!-- Right Side: Narrative & Metadata -->
            <div class="lg:col-span-5 lg:border-l-2 lg:border-emerald-500/20 lg:pl-8 flex flex-col justify-between py-1 space-y-4">
                <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 leading-relaxed font-normal">
                    UKM Computer Education menghadirkan ruang pengembangan diri melalui berbagai bidang organisasi dan teknologi. Temukan minat, asah keterampilan, bangun kolaborasi, dan ciptakan inovasi bersama.
                </p>

                <!-- Status Metadata Badges -->
                <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-gray-700 dark:text-gray-300 select-none pt-1">
                    <span class="inline-flex items-center gap-1.5">
                        <i class="ph-bold ph-users text-sm text-emerald-600 dark:text-emerald-400"></i>
                        <span>2 DIVISI UTAMA</span>
                    </span>
                    <span class="text-gray-300 dark:text-gray-700">•</span>
                    <span class="inline-flex items-center gap-1.5">
                        <i class="ph-bold ph-check-circle text-sm text-emerald-600 dark:text-emerald-400"></i>
                        <span>4 SUB-BIDANG AKTIF</span>
                    </span>
                </div>
            </div>

        </div>

        <!-- 2 Grand Division Cards Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
            
            <!-- CARD 1: DIVISI ORGANISASI (Dark Emerald Card) -->
            <div class="group relative rounded-[28px] sm:rounded-[36px] bg-[#072417] text-white p-6 sm:p-8 lg:p-9 shadow-xl overflow-hidden flex flex-col justify-between border border-emerald-900/40 transition-transform duration-500 hover:-translate-y-1">
                
                <!-- Watermark Number & Blueprint Accents -->
                <div class="absolute -top-6 -right-3 text-[130px] sm:text-[160px] font-black text-white/[0.04] pointer-events-none select-none font-mono leading-none">
                    01
                </div>
                <!-- Subtle Blueprint Circuit Corner Accent -->
                <div class="absolute -bottom-10 -right-10 w-44 h-44 rounded-full border border-emerald-500/10 pointer-events-none"></div>

                <!-- Top Header Row -->
                <div class="relative z-10 flex items-start justify-between gap-4 mb-6">
                    <!-- Icon Leadership / Organization -->
                    <div class="flex h-11 w-11 sm:h-12 sm:w-12 items-center justify-center rounded-2xl bg-[#0e3b26] border border-emerald-500/20 text-[#a3e635] shadow-inner">
                        <i class="ph-bold ph-users-three text-xl sm:text-2xl"></i>
                    </div>

                    <!-- Right Indicator Tag -->
                    <div class="text-right select-none">
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-950/80 border border-emerald-500/20 px-3 py-1 text-[10px] font-bold text-emerald-300 uppercase tracking-wider">
                            <span class="h-1.5 w-1.5 rounded-full bg-[#a3e635]"></span>
                            <span>PILAR ORGANISASIONAL</span>
                        </span>
                        <span class="block font-mono text-[10px] text-emerald-400/60 tracking-wider mt-1">
                            DIV-01 // CE.UMC
                        </span>
                    </div>
                </div>

                <!-- Division Name & Description -->
                <div class="relative z-10 mb-6">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">
                        — FONDASI & KEPEMIMPINAN
                    </span>
                    <h3 class="text-2xl sm:text-3xl font-extrabold text-white mt-1 mb-2">
                        Divisi Organisasi
                    </h3>
                    <p class="text-xs sm:text-sm text-emerald-100/75 leading-relaxed">
                        Membangun fondasi organisasi yang solid melalui pengembangan anggota, kaderisasi, kewirausahaan, dan kemitraan strategis.
                    </p>
                </div>

                <!-- 2 Sub-Units Nested Cards -->
                <div class="relative z-10 space-y-4 mb-6">
                    
                    <!-- Sub-unit 01 -->
                    <div class="rounded-2xl bg-[#0e3b26] border border-emerald-500/15 p-4 sm:p-5 shadow-sm transition-colors hover:border-emerald-500/30">
                        <div class="flex items-start gap-3.5">
                            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-[#a3e635]/15 border border-[#a3e635]/40 font-mono text-xs font-bold text-[#a3e635]">
                                01
                            </span>
                            <div class="space-y-1">
                                <h4 class="text-sm sm:text-base font-bold text-white leading-tight">
                                    Pengembangan Organisasi dan Kaderisasi
                                </h4>
                                <p class="text-xs text-emerald-100/70 leading-relaxed">
                                    Berfokus pada pengembangan kapasitas anggota, kaderisasi, kepemimpinan, serta penguatan internal organisasi.
                                </p>
                                <div class="flex flex-wrap gap-1.5 pt-2">
                                    <span class="rounded-md bg-[#072417] px-2 py-0.5 text-[10px] font-semibold text-emerald-300">#Kaderisasi</span>
                                    <span class="rounded-md bg-[#072417] px-2 py-0.5 text-[10px] font-semibold text-emerald-300">#Leadership</span>
                                    <span class="rounded-md bg-[#072417] px-2 py-0.5 text-[10px] font-semibold text-emerald-300">#InternalSolid</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sub-unit 02 -->
                    <div class="rounded-2xl bg-[#0e3b26] border border-emerald-500/15 p-4 sm:p-5 shadow-sm transition-colors hover:border-emerald-500/30">
                        <div class="flex items-start gap-3.5">
                            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-[#a3e635]/15 border border-[#a3e635]/40 font-mono text-xs font-bold text-[#a3e635]">
                                02
                            </span>
                            <div class="space-y-1">
                                <h4 class="text-sm sm:text-base font-bold text-white leading-tight">
                                    Bisnis dan Kemitraan
                                </h4>
                                <p class="text-xs text-emerald-100/70 leading-relaxed">
                                    Mengembangkan jiwa kewirausahaan, unit usaha, sponsorship, dan kolaborasi dengan berbagai mitra eksternal.
                                </p>
                                <div class="flex flex-wrap gap-1.5 pt-2">
                                    <span class="rounded-md bg-[#072417] px-2 py-0.5 text-[10px] font-semibold text-emerald-300">#Entrepreneurship</span>
                                    <span class="rounded-md bg-[#072417] px-2 py-0.5 text-[10px] font-semibold text-emerald-300">#Sponsorship</span>
                                    <span class="rounded-md bg-[#072417] px-2 py-0.5 text-[10px] font-semibold text-emerald-300">#ExternalCollab</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Card Footer (Status & Action Button) -->
                <div class="relative z-10 flex items-center justify-between pt-4 border-t border-emerald-500/15">
                    <span class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-400 select-none">
                        <span class="h-2 w-2 rounded-full bg-[#a3e635] animate-pulse"></span>
                        <span>STATUS: AKTIF</span>
                    </span>

                    <a
                        href="/pengurus"
                        class="inline-flex items-center gap-2 rounded-full bg-[#a3e635] hover:bg-[#bef264] text-gray-950 font-bold px-5 py-2.5 text-xs transition-all duration-200 hover:scale-105 active:scale-95 shadow-md shadow-[#a3e635]/20">
                        <span>Jelajahi Divisi</span>
                        <i class="ph-bold ph-arrow-right text-xs"></i>
                    </a>
                </div>

            </div>

            <!-- CARD 2: DIVISI COMPUTER (Light Mint Card) -->
            <div class="group relative rounded-[28px] sm:rounded-[36px] bg-[#d2f4e3] text-gray-900 p-6 sm:p-8 lg:p-9 shadow-xl overflow-hidden flex flex-col justify-between border border-emerald-400/30 transition-transform duration-500 hover:-translate-y-1">
                
                <!-- Watermark Number & Blueprint Accents -->
                <div class="absolute -top-6 -right-3 text-[130px] sm:text-[160px] font-black text-emerald-950/[0.05] pointer-events-none select-none font-mono leading-none">
                    02
                </div>
                <!-- Subtle Blueprint Circuit Corner Accent -->
                <div class="absolute -bottom-10 -right-10 w-44 h-44 rounded-full border border-emerald-700/10 pointer-events-none"></div>

                <!-- Top Header Row -->
                <div class="relative z-10 flex items-start justify-between gap-4 mb-6">
                    <!-- Icon Tech Coding -->
                    <div class="flex h-11 w-11 sm:h-12 sm:w-12 items-center justify-center rounded-2xl bg-[#072417] text-[#a3e635] shadow-md">
                        <span class="font-mono text-base font-bold">&lt;/&gt;</span>
                    </div>

                    <!-- Right Indicator Tag -->
                    <div class="text-right select-none">
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-white/70 border border-emerald-700/20 px-3 py-1 text-[10px] font-bold text-emerald-900 uppercase tracking-wider shadow-2xs">
                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
                            <span>PILAR TEKNOLOGI & KARYA</span>
                        </span>
                        <span class="block font-mono text-[10px] text-emerald-800/60 tracking-wider mt-1">
                            DIV-02 // CE.UMC
                        </span>
                    </div>
                </div>

                <!-- Division Name & Description -->
                <div class="relative z-10 mb-6">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-800">
                        — RISET, DIGITAL & INFORMASI
                    </span>
                    <h3 class="text-2xl sm:text-3xl font-extrabold text-gray-950 mt-1 mb-2">
                        Divisi Computer
                    </h3>
                    <p class="text-xs sm:text-sm text-gray-700 leading-relaxed">
                        Menjadi ruang eksplorasi teknologi informasi, pengembangan keterampilan digital, riset, dan kreativitas dalam dunia teknologi.
                    </p>
                </div>

                <!-- 2 Sub-Units Nested Cards (White Background) -->
                <div class="relative z-10 space-y-4 mb-6">
                    
                    <!-- Sub-unit 01 -->
                    <div class="rounded-2xl bg-white/95 border border-emerald-900/5 p-4 sm:p-5 shadow-sm transition-colors hover:border-emerald-600/30">
                        <div class="flex items-start gap-3.5">
                            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-[#072417] font-mono text-xs font-bold text-white">
                                01
                            </span>
                            <div class="space-y-1">
                                <h4 class="text-sm sm:text-base font-bold text-gray-950 leading-tight">
                                    Riset dan Teknologi (RISTEK)
                                </h4>
                                <p class="text-xs text-gray-600 leading-relaxed">
                                    Menjadi ruang eksplorasi, pembelajaran, riset, dan pengembangan teknologi seperti programming, artificial intelligence, networking, dan inovasi digital.
                                </p>
                                <div class="flex flex-wrap gap-1.5 pt-2">
                                    <span class="rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-800">#Programming</span>
                                    <span class="rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-800">#ArtificialIntelligence</span>
                                    <span class="rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-800">#Networking</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sub-unit 02 -->
                    <div class="rounded-2xl bg-white/95 border border-emerald-900/5 p-4 sm:p-5 shadow-sm transition-colors hover:border-emerald-600/30">
                        <div class="flex items-start gap-3.5">
                            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-[#072417] font-mono text-xs font-bold text-white">
                                02
                            </span>
                            <div class="space-y-1">
                                <h4 class="text-sm sm:text-base font-bold text-gray-950 leading-tight">
                                    Dokumentasi, Komunikasi, dan Informasi (DOKOMINFO)
                                </h4>
                                <p class="text-xs text-gray-600 leading-relaxed">
                                    Mengelola dokumentasi, publikasi, desain grafis, multimedia, media sosial, serta penyebaran informasi organisasi.
                                </p>
                                <div class="flex flex-wrap gap-1.5 pt-2">
                                    <span class="rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-800">#GraphicDesign</span>
                                    <span class="rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-800">#Multimedia</span>
                                    <span class="rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-800">#PublicRelations</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Card Footer (Status & Action Button) -->
                <div class="relative z-10 flex items-center justify-between pt-4 border-t border-emerald-900/10">
                    <span class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-900 select-none">
                        <span class="h-2 w-2 rounded-full bg-emerald-700 animate-pulse"></span>
                        <span>STATUS: RISET & KARYA</span>
                    </span>

                    <a
                        href="/learning"
                        class="inline-flex items-center gap-2 rounded-full bg-[#072417] hover:bg-[#0c3522] text-white font-bold px-5 py-2.5 text-xs transition-all duration-200 hover:scale-105 active:scale-95 shadow-md shadow-emerald-950/20">
                        <span>Jelajahi Divisi</span>
                        <i class="ph-bold ph-arrow-right text-xs"></i>
                    </a>
                </div>

            </div>

        </div>

    </div>
</section>
