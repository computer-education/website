---
import { getCollection } from 'astro:content';
import LearnCard from '../../components/LearnCard.astro';

// Mengambil data dari content collections 'modul'
const allModul = await getCollection('modul');
// Hanya ambil file index.md yang berada di level teratas (contoh: programing/index.md)
const topLevelModules = allModul.filter(m => {
    return m.filePath && m.filePath.endsWith('index.md') && m.id.split('/').length === 1;
});

// Mengurutkan berdasarkan weight (dari yang terkecil)
const sortedModules = topLevelModules.sort((a, b) => (a.data.weight || 0) - (b.data.weight || 0));
---

<!-- Learning Tracks Section -->
<section class="border-t border-gray-100 dark:border-gray-800/60 bg-white dark:bg-gray-950 transition-colors duration-300 py-16 sm:py-24" id="learning">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
        
        <!-- Header dengan Kontrol Navigasi Slider Responsif -->
        <div class="mb-8 sm:mb-12 flex flex-col md:flex-row md:items-end md:justify-between gap-5 sm:gap-6">
            <div class="max-w-2xl">
                <div class="flex items-center gap-2 text-xs font-semibold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider mb-2">
                    <span>Kurikulum & Peminatan</span>
                    <span>•</span>
                    <span class="text-gray-500 dark:text-gray-400">Silabus Mandiri</span>
                </div>
                <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-gray-950 dark:text-white leading-tight">
                    Jalur Belajar Mahasiswa
                </h2>
                <p class="mt-2 text-sm sm:text-base text-gray-600 dark:text-gray-300 leading-relaxed font-normal">
                    Pilih peminatan keahlian sesuai minat. Materi dirancang bertahap mulai dari konsep dasar hingga siap menggarap proyek nyata.
                </p>
            </div>

            <!-- Tombol Navigasi Slider (Tersedia di HP & Desktop dengan Ukuran Proporsional) -->
            <div class="flex items-center justify-end gap-2.5 sm:gap-3 shrink-0">
                <button
                    class="learn-prev w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-200 shadow-sm hover:bg-green-600 hover:border-green-600 hover:text-white active:scale-95 transition-all duration-300 flex items-center justify-center cursor-pointer"
                    aria-label="Previous Slide">
                    <i class="ph ph-arrow-left text-lg sm:text-xl"></i>
                </button>
                <button
                    class="learn-next w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-200 shadow-sm hover:bg-green-600 hover:border-green-600 hover:text-white active:scale-95 transition-all duration-300 flex items-center justify-center cursor-pointer"
                    aria-label="Next Slide">
                    <i class="ph ph-arrow-right text-lg sm:text-xl"></i>
                </button>
            </div>
        </div>

        <!-- Swiper Container dengan Spacing Luas -->
        <div class="swiper learn-container !py-4 overflow-hidden">
            <div class="swiper-wrapper py-2">
                {sortedModules.length > 0 ? (
                    sortedModules.map((module) => (
                        <div class="swiper-slide h-auto">
                            <LearnCard module={module} />
                        </div>
                    ))
                ) : (
                    <div class="swiper-slide text-center text-gray-500 py-16">
                        Data modul pembelajaran belum tersedia.
                    </div>
                )}
            </div>
            
            <!-- Pagination Bullets (Mobile & Desktop) -->
            <div class="learn-pagination flex justify-center gap-1.5 sm:gap-2 mt-6 sm:mt-10"></div>
        </div>

        <!-- Tombol Call to Action di Bawah (Ukuran Responsif untuk HP & Desktop) -->
        <div class="mt-8 sm:mt-16 text-center px-4">
            <a
                href="/learning"
                class="group inline-flex items-center justify-center gap-2.5 sm:gap-3 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-900 px-6 py-3 sm:px-8 sm:py-3.5 font-semibold sm:font-bold text-sm sm:text-base shadow-lg shadow-gray-900/10 hover:shadow-green-500/20 hover:bg-green-600 dark:hover:bg-green-500 dark:hover:text-white transition-all duration-300 hover:-translate-y-0.5 active:scale-98 w-full sm:w-auto max-w-sm sm:max-w-none">
                <span>Jelajahi Semua Silabus & Modul</span>
                <i class="ph ph-arrow-up-right text-base sm:text-lg transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"></i>
            </a>
        </div>

    </div>
</section>

<!-- Custom Swiper Pagination Styles -->
<style is:global>
    .learn-pagination .swiper-pagination-bullet {
        width: 8px;
        height: 8px;
        background: #9ca3af;
        opacity: 0.4;
        transition: all 0.3s ease;
        border-radius: 9999px;
    }
    @media (min-width: 640px) {
        .learn-pagination .swiper-pagination-bullet {
            width: 10px;
            height: 10px;
        }
    }
    .learn-pagination .swiper-pagination-bullet-active {
        width: 24px;
        background: #16a34a !important; /* emerald/green-600 */
        opacity: 1 !important;
        border-radius: 9999px;
    }
    @media (min-width: 640px) {
        .learn-pagination .swiper-pagination-bullet-active {
            width: 32px;
        }
    }
</style>

<script>
    import Swiper from 'swiper/bundle';

    const initLearnSwiper = () => {
        const container = document.querySelector('.learn-container');
        if (!container) return;

        if ((container as any).swiper) {
            (container as any).swiper.destroy(true, true);
        }

        new Swiper('.learn-container', {
            loop: false,
            grabCursor: true,
            speed: 600,
            slidesPerView: 1.15,
            spaceBetween: 16,
            navigation: {
                prevEl: '.learn-prev',
                nextEl: '.learn-next',
            },
            pagination: {
                el: '.learn-pagination',
                clickable: true,
            },
            breakpoints: {
                640: {
                    slidesPerView: 2,
                    spaceBetween: 20,
                },
                1024: {
                    slidesPerView: 3,
                    spaceBetween: 28,
                },
                1280: {
                    slidesPerView: 3,
                    spaceBetween: 32,
                }
            }
        });
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLearnSwiper);
    } else {
        initLearnSwiper();
    }
</script>
