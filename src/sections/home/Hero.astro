---
import { Image } from 'astro:assets'
import rotasiImg from '../../assets/images/rotasi.png'
import maskotImg from '../../assets/images/Maskot_CE-removebg-preview.png'
import coreldrawImg from '../../assets/images/coreldraw.png'
import codingImg from '../../assets/images/coding.png'
import videoImg from '../../assets/images/video.png'
import cameraaImg from '../../assets/images/cameraa.png'
---

<!-- Hero Section -->
<section class="relative min-h-screen w-full overflow-hidden pt-28 sm:pt-36 pb-16 sm:pb-24 flex flex-col justify-center" id="home">
    <!-- Background Hexagons -->
    <div class="contener pointer-events-none select-none">
        <div class="curser"></div>
        {
            Array.from({ length: 24 }).map((_) => (
                <div class="row">
                    {Array.from({ length: 18 }).map((_) => (
                        <div class="hexagon" />
                    ))}
                </div>
            ))
        }
    </div>

    <!-- Content Grid -->
    <div class="relative z-10 container mx-auto grid h-full items-center gap-8 md:gap-12 px-5 sm:px-8 md:grid-cols-2 md:px-12">
        <!-- Left Column: Text -->
        <div class="space-y-6 text-center md:text-left">
            <div class="inline-flex items-center gap-2 rounded-full border border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-900/80 px-3.5 py-1 text-xs font-semibold text-gray-700 dark:text-gray-300 shadow-xs backdrop-blur-xs">
                <span class="h-2 w-2 rounded-full bg-emerald-600"></span>
                <span>Unit Kegiatan Mahasiswa • UM Cirebon</span>
            </div>

            <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-gray-950 dark:text-white leading-[1.12]">
                Computer Education
            </h1>

            <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 leading-relaxed font-normal max-w-xl mx-auto md:mx-0">
                Wadah mahasiswa untuk mendalami rekayasa perangkat lunak, desain grafis, multimedia kreatif, dan infrastruktur sistem komputer sejak 2001.
            </p>

            <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 pt-2">
                <a
                    href="https://forms.gle/4b4VrtB3DuYyUnGRA"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center rounded-lg bg-emerald-700 hover:bg-emerald-800 dark:bg-emerald-600 dark:hover:bg-emerald-500 px-6 py-3 font-semibold text-sm text-white shadow-xs transition-colors">
                    Daftar Anggota
                </a>
                <a
                    href="/buku-saku"
                    class="inline-flex items-center justify-center rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 hover:bg-gray-50 dark:hover:bg-gray-800 px-5 py-3 font-medium text-sm text-gray-800 dark:text-gray-200 transition-colors">
                    Buku Saku Organisasi
                </a>
                <a
                    href="#learning"
                    class="inline-flex items-center justify-center rounded-lg border border-transparent hover:border-gray-200 dark:hover:border-gray-800 bg-transparent hover:bg-gray-100/80 dark:hover:bg-gray-800/80 px-4 py-3 font-medium text-sm text-gray-600 dark:text-gray-300 transition-colors">
                    Jalur Belajar
                </a>
            </div>
        </div>

        <!-- Right Column: Visuals (Mascot & Floating Icons) -->
        <div class="relative flex h-[380px] sm:h-[450px] md:h-[520px] lg:h-[560px] items-center justify-center">
            <!-- Rotating Background behind Mascot -->
            <Image
                src={rotasiImg}
                class="rotasi-img absolute w-[300px] sm:w-[380px] md:w-[460px] lg:w-[500px] opacity-90"
                alt="Rotating Background"
            />

            <!-- Mascot -->
            <Image
                src={maskotImg}
                class="logo-mantul relative z-20 w-[205px] sm:w-[250px] md:w-[290px] lg:w-[320px] drop-shadow-2xl"
                alt="Mascot CE"
            />

            <!-- Floating Icons (Positioned relative to this column) -->
            <!-- CorelDraw -->
            <div class="animasi-satu absolute top-1 left-2 z-30 sm:top-2 sm:left-6 md:left-8">
                <Image src={coreldrawImg} class="h-14 w-14 sm:h-16 sm:w-16 md:h-20 md:w-20 drop-shadow-lg" alt="CorelDraw" />
            </div>

            <!-- Coding -->
            <Image
                src={codingImg}
                class="animasi-2 absolute bottom-2 left-2 z-30 sm:bottom-6 sm:left-6 md:left-8 h-12 w-12 sm:h-15 sm:w-15 md:h-18 md:w-18 drop-shadow-lg"
                alt="Coding"
            />

            <!-- Video -->
            <Image
                src={videoImg}
                class="animasi-3 absolute right-2 bottom-6 z-30 sm:right-6 sm:bottom-10 md:right-8 h-12 w-12 sm:h-15 sm:w-15 md:h-18 md:w-18 drop-shadow-lg"
                alt="Video"
            />

            <!-- Camera -->
            <Image
                src={cameraaImg}
                class="animasi-4 absolute top-2 right-2 z-30 sm:top-4 sm:right-6 md:right-6 h-12 w-12 sm:h-15 sm:w-15 md:h-18 md:w-18 drop-shadow-lg"
                alt="Camera"
            />
        </div>
    </div>
</section>
