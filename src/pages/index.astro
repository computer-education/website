---
import Layout from '../layouts/BaseLayout.astro'
import Hero from '../sections/home/Hero.astro';
import About from '../sections/home/About.astro';
import Stats from '../sections/home/Stats.astro';
import VideoProfile from '../sections/home/VideoProfile.astro';
import Divisi from '../sections/home/Divisi.astro';
import ProgramKegiatan from '../sections/home/ProgramKegiatan.astro';
import Learning from '../sections/home/Learning.astro';
import Pengurus from '../sections/home/Pengurus.astro';
---

<Layout>
    <Hero/>
    <About/>
    <Stats/>
    <VideoProfile/>
    <Divisi/>
    <ProgramKegiatan/>
    <Learning/>
    <Pengurus/>
</Layout>

<style>
    @keyframes bounce-slow {
        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    .animate-bounce-slow {
        animation: bounce-slow 3s infinite;
    }
</style>
