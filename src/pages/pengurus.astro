---
import Layout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const allPengurus = await getCollection('pengurus');

// Group by urutan
const grouped = allPengurus.reduce((acc, current) => {
    const urutan = current.data.urutan || 99;
    if (!acc[urutan]) {
        acc[urutan] = [];
    }
    acc[urutan].push(current);
    return acc;
}, {} as Record<number, typeof allPengurus>);

const urutanKeys = Object.keys(grouped).map(Number).sort((a, b) => a - b);
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/pengurus/*.{jpeg,jpg,png,gif,webp}');
---

<Layout 
    title="Susunan Pengurus | Computer Education"
    description="Struktur bagan kepengurusan Unit Kegiatan Mahasiswa Computer Education Universitas Muhammadiyah Cirebon periode aktif.">
    
    <!-- Hero Section -->
    <header class="border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 pt-28 pb-14 transition-colors">
        <div class="container mx-auto px-4 sm:px-6 md:px-8 max-w-4xl text-center space-y-4">
            <span class="inline-block text-xs font-bold tracking-wider text-emerald-800 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-3 py-1 rounded-full border border-emerald-200/60 dark:border-emerald-800/60 uppercase">
                Struktur Organisasi
            </span>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-gray-950 dark:text-white leading-tight">
                Susunan Pengurus
            </h1>
            <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto font-normal leading-relaxed">
                Bagan hierarki fungsional kepengurusan UKM Computer Education Universitas Muhammadiyah Cirebon.
            </p>
        </div>
    </header>

    <main class="bg-gray-50/50 dark:bg-gray-900/40 py-16 transition-colors min-h-screen">
        <div class="container mx-auto px-4 sm:px-6 md:px-8 max-w-6xl">
            
            <div class="flex flex-col items-center">
                {urutanKeys.map((urutan, index) => {
                    const pengurusList = grouped[urutan];
                    const isLast = index === urutanKeys.length - 1;

                    return (
                        <div class="w-full flex flex-col items-center relative mb-10 sm:mb-14">
                            <!-- Group of Cards -->
                            <div class="flex flex-wrap justify-center gap-4 sm:gap-6 w-full z-10">
                                {pengurusList.map((p) => {
                                    const imageSrc = typeof p.data.foto === 'string'
                                        ? (images[`/src/assets/images/pengurus/${p.data.foto.split('/').pop()}`]?.() ?? null)
                                        : p.data.foto;
                                    
                                    return (
                                        <div class="group relative flex flex-col items-center bg-white dark:bg-gray-900 p-5 rounded-xl shadow-2xs border border-gray-200 dark:border-gray-800 hover:border-emerald-600/50 dark:hover:border-emerald-500/50 transition-colors w-full sm:w-[220px] md:w-[240px]">
                                             
                                            <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full mb-3.5 bg-gray-100 dark:bg-gray-800 overflow-hidden border-2 border-gray-200 dark:border-gray-700 relative shrink-0">
                                                {imageSrc ? (
                                                    <Image 
                                                        src={imageSrc} 
                                                        alt={p.data.nama} 
                                                        class="w-full h-full object-cover" 
                                                    />
                                                ) : (
                                                    <div class="w-full h-full flex items-center justify-center text-gray-400 dark:text-gray-500">
                                                        <i class="ph-fill ph-user text-3xl"></i>
                                                    </div>
                                                )}
                                            </div>
                                             
                                            <div class="text-center w-full">
                                                <h3 class="font-bold text-gray-950 dark:text-white text-sm sm:text-base leading-snug mb-1 line-clamp-2">
                                                    {p.data.nama}
                                                </h3>
                                                <p class="text-xs font-semibold text-emerald-700 dark:text-emerald-400">
                                                    {p.data.jabatan}
                                                </p>
                                            </div>
                                        </div>
                                    )
                                })}
                            </div>

                            <!-- Indikator panah ke level berikutnya -->
                            {!isLast && (
                                <div class="w-full flex justify-center mt-6 text-gray-300 dark:text-gray-700">
                                    <i class="ph-bold ph-caret-down text-xl"></i>
                                </div>
                            )}
                        </div>
                    )
                })}

                {urutanKeys.length === 0 && (
                    <div class="text-center py-16 text-gray-500 dark:text-gray-400 w-full bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800">
                        <i class="ph ph-users text-4xl mb-2 opacity-50 block mx-auto"></i>
                        <p class="text-base font-medium">Data susunan pengurus belum tersedia.</p>
                        <p class="text-xs mt-1 text-gray-400">Dapat ditambahkan melalui dasbor Keystatic.</p>
                    </div>
                )}
            </div>
            
        </div>
    </main>
</Layout>
