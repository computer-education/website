---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

const allKegiatan = await getCollection('kegiatan');
const sortedKegiatan = allKegiatan.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (date: Date) => {
    return new Intl.DateTimeFormat('id-ID', {
        dateStyle: 'medium',
    }).format(date);
};
---

<Layout 
    title="Galeri Kegiatan | Computer Education"
    description="Dokumentasi agenda, workshop, kaderisasi, dan kegiatan UKM Computer Education Universitas Muhammadiyah Cirebon.">
    
    <!-- Header -->
    <header class="border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 pt-28 pb-12 transition-colors">
        <div class="container mx-auto px-4 sm:px-6 md:px-8 max-w-4xl text-center space-y-3">
            <div class="flex items-center justify-center gap-2 text-xs font-semibold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider">
                <span>Dokumentasi Arsip</span>
                <span>•</span>
                <span class="text-gray-500 dark:text-gray-400">Kegiatan Organisasi</span>
            </div>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-gray-950 dark:text-white">
                Galeri Kegiatan
            </h1>
            <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto leading-relaxed">
                Dokumentasi foto dan catatan kegiatan kaderisasi, workshop, seminar, dan peringatan hari lahir UKM Computer Education UMC.
            </p>
        </div>
    </header>

    <!-- Grid -->
    <main class="bg-gray-50/60 dark:bg-gray-900/40 py-12 sm:py-16 min-h-[60vh] transition-colors">
        <div class="container mx-auto px-4 sm:px-6 md:px-8 max-w-7xl">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                {sortedKegiatan.length === 0 ? (
                    <div class="col-span-full text-center text-gray-500 py-16">
                        Belum ada data dokumentasi kegiatan.
                    </div>
                ) : (
                    sortedKegiatan.map((kegiatan) => {
                        const Thumbnail = kegiatan.data.image;

                        return (
                            <a
                                href={`/kegiatan/${kegiatan.id}`}
                                class="group flex flex-col rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-3 shadow-xs transition-colors hover:border-emerald-600/50">
                                
                                <div class="relative mb-3 h-44 w-full overflow-hidden rounded-lg bg-gray-100 dark:bg-gray-800 shrink-0">
                                    {Thumbnail ? (
                                        <Image
                                            src={Thumbnail}
                                            alt={kegiatan.data.title}
                                            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" 
                                        />
                                    ) : (
                                        <div class="h-full w-full flex items-center justify-center text-gray-400">
                                            <i class="ph ph-image text-3xl"></i>
                                        </div>
                                    )}
                                </div>
                                
                                <div class="flex grow flex-col px-1 pb-2">
                                    <div class="mb-2 flex items-center gap-3 text-xs text-gray-500 dark:text-gray-400">
                                        <span class="flex items-center gap-1">
                                            <i class="ph-fill ph-calendar-blank text-emerald-600 dark:text-emerald-400"></i> {formatDate(kegiatan.data.date)}
                                        </span>
                                        {kegiatan.data.location && (
                                            <span class="flex items-center gap-1 line-clamp-1">
                                                <i class="ph-fill ph-map-pin"></i> {kegiatan.data.location}
                                            </span>
                                        )}
                                    </div>
                                    
                                    <h3 class="mb-1.5 text-base font-bold text-gray-900 dark:text-white transition-colors group-hover:text-emerald-700 dark:group-hover:text-emerald-400 line-clamp-2">
                                        {kegiatan.data.title}
                                    </h3>
                                    
                                    {kegiatan.data.description && (
                                        <p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400 line-clamp-2 mb-3 grow">
                                            {kegiatan.data.description}
                                        </p>
                                    )}
                                    
                                    <div class="mt-auto pt-2 border-t border-gray-100 dark:border-gray-800 flex items-center justify-between text-xs font-semibold text-emerald-700 dark:text-emerald-400">
                                        <span>Lihat Album</span>
                                        <i class="ph-bold ph-arrow-right"></i>
                                    </div>
                                </div>
                            </a>
                        );
                    })
                )}
            </div>
        </div>
    </main>
</Layout>
