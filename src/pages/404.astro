---
import Layout from '../layouts/BaseLayout.astro';
---

<Layout title="404 - Halaman Tidak Ditemukan | Computer Education">
    <div class="flex min-h-[75vh] items-center justify-center px-4 py-20 transition-colors">
        <div class="max-w-xl text-center space-y-4">
            <span class="inline-block text-7xl sm:text-8xl font-black text-emerald-700 dark:text-emerald-500 tracking-tight">
                404
            </span>

            <h1 class="text-2xl sm:text-3xl font-bold text-gray-950 dark:text-white">
                Halaman Tidak Ditemukan
            </h1>

            <p class="text-base text-gray-600 dark:text-gray-400 max-w-md mx-auto leading-relaxed">
                Halaman yang Anda tuju mungkin sudah dipindahkan, diubah tautannya, atau tidak lagi tersedia.
            </p>

            <div class="flex flex-wrap items-center justify-center gap-3 pt-4">
                <a
                    href="/"
                    class="rounded-lg bg-emerald-700 hover:bg-emerald-800 dark:bg-emerald-600 dark:hover:bg-emerald-500 px-6 py-2.5 text-sm font-semibold text-white shadow-xs transition-colors">
                    Kembali ke Beranda
                </a>
                <a
                    href="/buku-saku"
                    class="rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 hover:bg-gray-50 dark:hover:bg-gray-800 px-5 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-200 transition-colors">
                    Buku Saku
                </a>
            </div>
        </div>
    </div>
</Layout>
