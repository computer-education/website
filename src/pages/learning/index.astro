---
import Layout from '../../layouts/BaseLayout.astro';
import LearnCard from '../../components/LearnCard.astro';
import { getCollection } from 'astro:content';

const allModul = await getCollection('modul');
const topLevelModules = allModul.filter(m => {
    return m.filePath && m.filePath.endsWith('index.md') && m.id.split('/').length === 1;
});
const sortedModules = topLevelModules.sort((a, b) => (a.data.weight || 0) - (b.data.weight || 0));
---

<Layout 
    title="Jalur Pembelajaran | Computer Education"
    description="Silabus kurikulum dan modul materi UKM Computer Education Universitas Muhammadiyah Cirebon: Pemrograman, Desain Grafis, Video Editing, dan Sistem Operasi.">
    
    <!-- Header -->
    <header class="border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 pt-28 pb-12 transition-colors">
        <div class="container mx-auto px-4 sm:px-6 md:px-8 max-w-4xl text-center space-y-3">
            <div class="flex items-center justify-center gap-2 text-xs font-semibold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider">
                <span>Kurikulum Mandiri</span>
                <span>•</span>
                <span class="text-gray-500 dark:text-gray-400">Silabus Anggota</span>
            </div>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-gray-950 dark:text-white">
                Jalur Pembelajaran
            </h1>
            <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto leading-relaxed">
                Pilih jalur peminatan keahlian untuk mempelajari materi bertingkat dari dasar teori hingga praktik nyata.
            </p>
        </div>
    </header>

    <!-- Track Grid -->
    <main class="bg-gray-50/60 dark:bg-gray-900/40 py-12 sm:py-16 min-h-[60vh] transition-colors">
        <div class="container mx-auto px-4 sm:px-6 md:px-8 max-w-6xl">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
                {sortedModules.length === 0 ? (
                    <div class="col-span-full text-center text-gray-500 py-16">
                        Data modul belum tersedia.
                    </div>
                ) : (
                    sortedModules.map((module) => (
                        <div class="h-full">
                            <LearnCard module={module} />
                        </div>
                    ))
                )}
            </div>
        </div>
    </main>
</Layout>
